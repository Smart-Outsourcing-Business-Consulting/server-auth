<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_auth_oidc_hr_department_mapping_list" model="ir.ui.view">
        <field name="name">auth.oidc.hr.department.mapping.list</field>
        <field name="model">auth.oidc.hr.department.mapping</field>
        <field name="arch" type="xml">
            <list>
                <field name="provider_id" />
                <field name="claim_value" />
                <field name="company_id" />
                <field name="department_id" />
                <field name="active" />
            </list>
        </field>
    </record>
    <record id="view_auth_oidc_hr_department_mapping_form" model="ir.ui.view">
        <field name="name">auth.oidc.hr.department.mapping.form</field>
        <field name="model">auth.oidc.hr.department.mapping</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="provider_id" />
                        <field name="claim_value" />
                        <field name="company_id" />
                        <field name="department_id" />
                        <field name="active" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_auth_oidc_hr_department_mapping" model="ir.actions.act_window">
        <field name="name">OIDC Department Mappings</field>
        <field name="res_model">auth.oidc.hr.department.mapping</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem
        id="menu_auth_oidc_hr_department_mapping"
        name="OIDC Department Mappings"
        parent="base.menu_administration"
        action="action_auth_oidc_hr_department_mapping"
        groups="base.group_system"
        sequence="90"
    />
</odoo>
